{
  "name": "job-search-desktop",
  "version": "1.1.0",
  "description": "Desktop app that collects jobs from supported sources, checks conditions honestly and helps you apply manually.",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && node scripts/dev.mjs",
    "icon": "node scripts/make-icon.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "author": "Job Search Desktop contributors",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "docx": "9.8.1",
    "mammoth": "1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "productName": "Job Search Desktop",
  "private": true,
  "build": {
    "appId": "app.jobsearchdesktop",
    "productName": "Job Search Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon-32.png",
        "to": "tray.png"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Job-Search-Desktop-mac-${arch}.${ext}",
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "writeUpdateInfo": false,
      "artifactName": "Job-Search-Desktop-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Job-Search-Desktop-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "Job-Search-Desktop-windows-${arch}-setup.${ext}"
    },
    "publish": null
  }
}
