# Job Search Desktop не читает секреты из .env: API-ключ вводится в приложении (Настройки → AI)
# и хранится в системном хранилище (macOS Keychain / Windows DPAPI через Electron safeStorage).
# Эти переменные нужны только для разработки и тестов.

# Отдельная папка данных (например, для демо/скриншотов на синтетических данных).
# JSD_USER_DATA=/tmp/job-search-desktop-demo

# Режим разработки: адрес Vite-сервера renderer (выставляется scripts/dev.mjs автоматически).
# JSD_DEV_URL=http://localhost:5173

# E2E: язык интерфейса (ru|en) и путь к упакованному бинарнику для проверки сборки.
# E2E_LANG=ru
# E2E_EXECUTABLE=/path/to/Job Search Desktop.app/Contents/MacOS/Job Search Desktop
